---
// The loan showcase in "Every loan, card and home": the demo's home mortgage,
// view by view. Terms & Schedule comes first, at full window height so it
// reaches the amortization schedule, with the chart's tooltip open on the year
// that is part Actual, part projection. Linked Assets shows the same link from
// the loan and from the home. Calculation method puts the app's settings panel
// beside the list of what Bench can calculate.
//
// Images come from docs-site/scripts/capture-landing.mjs ("loans" group).
import { Image } from 'astro:assets';

import terms from '../../assets/landing/loan-terms.png';
import link from '../../assets/landing/loan-link.png';
import repayments from '../../assets/landing/loan-repayments.png';
import assetsLoan from '../../assets/landing/loan-assets.png';
import assetsHome from '../../assets/landing/loan-assets-home.png';
import method from '../../assets/landing/loan-method.png';

const views = [
	{
		id: 'terms',
		label: 'Terms & Schedule',
		text: 'The loan as the contract reads, and where it is heading: payoff date, total interest, the balance year by year and every installment split into principal and interest. Point at any year to see what you repaid, how much of it was interest, and Actual’s balance beside Bench’s.',
	},
	{
		id: 'link',
		label: 'Link to Actual',
		text: 'Point Bench at the loan’s account in Actual. It reads the history, finds the opening balance and every repayment, and checks its starting balance against Actual’s before tracking a single installment.',
	},
	{
		id: 'repayments',
		label: 'Repayments',
		text: 'Every installment beside the payment that settled it in Actual: when it was paid, from which account, and how much of it was interest. What Actual owes and what Bench expects are compared, and a late or missing payment is flagged.',
	},
	{
		id: 'assets',
		label: 'Linked Assets',
		text: 'Link the loan to the home or car it paid for, in full or in part. The loan shows the equity it leaves in each asset, and the home shows the loan against its value, with loan-to-value and the equity your repayments have built.',
	},
	{
		id: 'method',
		label: 'Calculation method',
		text: 'Match your lender, not a textbook. Start from a preset or set every convention yourself, from how the rate is quoted to how each cent is rounded.',
	},
];

// What the calculation method can describe, in the app's own terms.
const capabilities = [
	{
		title: 'Loans',
		items: ['Mortgages, car, personal and student loans', 'Lines of credit and HELOCs', 'Loans you made to someone else'],
	},
	{
		title: 'Repayments',
		items: [
			'Level payment, constant principal or progressive principal',
			'Interest-only periods and a balloon at maturity',
			'Weekly, fortnightly, twice a month, monthly, quarterly or yearly',
		],
	},
	{
		title: 'Interest',
		items: [
			'Worked out daily or per payment period',
			'Nominal, compounded or effective annual rates',
			'Actual/365, Actual/360, Actual/Actual and 30/360',
		],
	},
	{
		title: 'Events',
		items: [
			'Extra payments, redraws and fees, once or repeating',
			'Rate changes and repayment changes',
			'An offset account that cuts the interest',
		],
	},
	{
		title: 'Your lender’s rules',
		items: [
			'Recasts and negative amortization',
			'Business-day due dates and rounding to the cent',
			'Continue from a lender statement',
		],
	},
];

// Shown at the full width of the page: offer widths up to 3x.
const shot = { format: 'webp' as const, widths: [1280, 2560, 3840], sizes: '(min-width: 1340px) 1280px, 94vw' };
---

<div class="loan-showcase" data-view="terms">
	<div class="views" role="tablist" aria-label="Loan views">
		{views.map((view, index) => (
			<button
				type="button"
				role="tab"
				id={`loan-tab-${view.id}`}
				aria-controls="loan-stage"
				aria-selected={index === 0 ? 'true' : 'false'}
				tabindex={index === 0 ? 0 : -1}
				data-view-to={view.id}
			>
				{view.label}
			</button>
		))}
	</div>

	<div class="explain" aria-live="polite">
		{views.map((view) => <p data-for-view={view.id}>{view.text}</p>)}
	</div>

	<div class="stage" id="loan-stage" role="tabpanel" aria-labelledby="loan-tab-terms" tabindex="0">
		<div class="layer" data-for-view="terms">
			<Image
				class="page"
				src={terms}
				alt="A home mortgage on Terms & Schedule: the loan terms beside its payoff in July 2044 and 160,138 of total interest, the balance over time with the tooltip open on 2026 (22,200 repaid, 8,938 of it principal and 13,261 interest, a 1,500 extra payment, and Actual's balance beside Bench's), the extra payments with the 2,988 of interest they saved, and the amortization schedule."
				{...shot}
			/>
		</div>

		<div class="layer" data-for-view="link">
			<Image
				class="page"
				src={link}
				alt="Linking the mortgage to its account in Actual: Bench found 28 transactions, the opening balance and 27 repayments, and its starting balance matches Actual's to the cent."
				{...shot}
			/>
		</div>

		<div class="layer" data-for-view="repayments">
			<Image
				class="page"
				src={repayments}
				alt="The Repayments tab: what is owed in Actual agrees with what Bench expects, the next payment and its due date, and every installment beside the payment that settled it, with its principal, interest and balance after."
				{...shot}
			/>
		</div>

		<div class="layer both-sides" data-for-view="assets">
			<figure>
				<figcaption>On the loan</figcaption>
				<Image
					src={assetsLoan}
					alt="The mortgage's Linked Assets: all of its 259,983 debt allocated to the family home, a combined loan-to-value of 58.5% and 184,516 of equity."
					{...shot}
				/>
			</figure>
			<figure>
				<figcaption>On the home</figcaption>
				<Image
					src={assetsHome}
					alt="The family home's Linked Loans: the mortgage against it, 58.5% loan-to-value, 19,333 of equity built by repayments since November 2024, and the 1,850 monthly payment."
					{...shot}
				/>
			</figure>
		</div>

		<div class="layer method" data-for-view="method">
			<Image
				class="sheet"
				src={method}
				alt="The Calculation method panel: how the rate is quoted, how interest accrues, is charged and capitalizes, the amortization and repayment amount, when the repayment is recalculated, the final repayment, and precision and rounding."
				widths={[440, 880, 1230]}
				sizes="(min-width: 1340px) 440px, 94vw"
				format="webp"
			/>
			<div class="capabilities">
				<p class="capabilities-title">What Bench can calculate</p>
				<dl>
					{capabilities.map((group) => (
						<div>
							<dt>{group.title}</dt>
							{group.items.map((item) => <dd>{item}</dd>)}
						</div>
					))}
				</dl>
			</div>
		</div>
	</div>
</div>

<script>
	for (const showcase of document.querySelectorAll<HTMLElement>('.loan-showcase')) {
		const tabs = [...showcase.querySelectorAll<HTMLButtonElement>('[data-view-to]')];
		const stage = showcase.querySelector<HTMLElement>('.stage');

		const setView = (view: string, focus = false) => {
			showcase.dataset.view = view;
			for (const tab of tabs) {
				const selected = tab.dataset.viewTo === view;
				tab.setAttribute('aria-selected', String(selected));
				tab.tabIndex = selected ? 0 : -1;
				if (selected) {
					stage?.setAttribute('aria-labelledby', tab.id);
					if (focus) tab.focus();
				}
			}
		};

		tabs.forEach((tab, index) => {
			tab.addEventListener('click', () => setView(tab.dataset.viewTo ?? 'terms'));
			tab.addEventListener('keydown', (event) => {
				const move = { ArrowRight: 1, ArrowLeft: -1 }[event.key];
				if (move === undefined) return;
				event.preventDefault();
				const next = tabs[(index + move + tabs.length) % tabs.length];
				setView(next.dataset.viewTo ?? 'terms', true);
			});
		});
	}
</script>

<style>
	/* The app's own tab bar, so the picture below reads as the page it opens. */
	.views {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem;
		border-bottom: 1px solid var(--line);
	}

	.views button {
		min-height: 44px;
		margin-bottom: -1px;
		padding: 0 1rem;
		border: 0;
		border-bottom: 2px solid transparent;
		background: transparent;
		color: var(--muted);
		font: inherit;
		font-weight: 600;
		cursor: pointer;
	}

	.views button:hover {
		color: var(--ink-soft);
	}

	.views button[aria-selected='true'] {
		color: var(--ink);
		border-bottom-color: var(--ledger);
	}

	.views button:focus-visible,
	.stage:focus-visible {
		outline: 2px solid var(--ledger);
		outline-offset: 2px;
	}

	.explain {
		min-height: calc(3 * 1.6em);
		margin-top: 1.25rem;
		max-width: 72ch;
		color: var(--ink-soft);
		font-size: 1.05rem;
	}

	.explain p {
		display: none;
		margin: 0;
	}

	[data-view='terms'] .explain [data-for-view='terms'],
	[data-view='link'] .explain [data-for-view='link'],
	[data-view='repayments'] .explain [data-for-view='repayments'],
	[data-view='assets'] .explain [data-for-view='assets'],
	[data-view='method'] .explain [data-for-view='method'] {
		display: block;
	}

	/* The stage: one view at a time, at the shape of the app's window. */
	.stage {
		position: relative;
		margin-top: 1.5rem;
		aspect-ratio: 1712 / 1032;
		border-radius: var(--radius-window);
		border: 1px solid var(--line);
		background: var(--surface);
		overflow: hidden;
		box-shadow:
			0 1px 0 rgba(21, 24, 30, 0.04),
			0 30px 60px -30px rgba(21, 40, 90, 0.35);
	}

	.layer {
		position: absolute;
		inset: 0;
		opacity: 0;
		visibility: hidden;
		transition:
			opacity 0.2s ease,
			visibility 0s linear 0.2s;
	}

	[data-view='terms'] .layer[data-for-view='terms'],
	[data-view='link'] .layer[data-for-view='link'],
	[data-view='repayments'] .layer[data-for-view='repayments'],
	[data-view='assets'] .layer[data-for-view='assets'],
	[data-view='method'] .layer[data-for-view='method'] {
		opacity: 1;
		visibility: visible;
		transition: opacity 0.2s ease;
	}

	.layer :global(img.page) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top left;
	}

	/* Linked Assets: each side of the link is one row, so both are shown. */
	.both-sides {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: clamp(1rem, 3vw, 2.5rem);
		padding: clamp(1rem, 3vw, 2.5rem);
		background: var(--paper);
	}

	.both-sides figure {
		margin: 0;
	}

	.both-sides figcaption,
	.capabilities-title {
		margin-bottom: 0.6rem;
		color: var(--ledger);
		font-weight: 700;
		font-size: 0.95rem;
	}

	.both-sides :global(img) {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 10px;
		border: 1px solid var(--line);
		box-shadow: 0 18px 40px -28px rgba(21, 40, 90, 0.4);
	}

	/* Calculation method: the app's panel, and what it can describe. */
	.method {
		display: flex;
		background: var(--paper);
	}

	.method :global(img.sheet) {
		flex: none;
		width: auto;
		height: 100%;
		object-fit: cover;
		object-position: top;
		border-right: 1px solid var(--line);
		box-shadow: 20px 0 50px -30px rgba(21, 40, 90, 0.35);
	}

	.capabilities {
		flex: 1;
		min-width: 0;
		align-self: center;
		padding: 0 clamp(1.25rem, 3.5vw, 3rem);
	}

	.capabilities dl {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(0.9rem, 2vw, 1.75rem) clamp(1.25rem, 3vw, 2.5rem);
		margin: 0;
	}

	.capabilities dt {
		margin-bottom: 0.3rem;
		color: var(--ink);
		font-weight: 700;
	}

	.capabilities dd {
		position: relative;
		margin: 0;
		padding: 0.15rem 0 0.15rem 1.1rem;
		color: var(--ink-soft);
		font-size: clamp(0.8rem, 1.15vw, 0.98rem);
		line-height: 1.4;
	}

	.capabilities dd::before {
		content: '';
		position: absolute;
		left: 0.1rem;
		top: 0.6em;
		width: 0.55rem;
		height: 0.3rem;
		border-left: 2px solid var(--gain);
		border-bottom: 2px solid var(--gain);
		transform: rotate(-45deg);
	}

	@media (max-width: 960px) {
		.capabilities dl {
			grid-template-columns: 1fr;
			gap: 0.6rem;
		}
	}

	@media (max-width: 760px) {
		/* One row of tabs that scrolls sideways, like the app's own. */
		.views {
			flex-wrap: nowrap;
			overflow-x: auto;
			scrollbar-width: none;
		}

		.views button {
			flex: none;
			padding: 0 0.75rem;
		}

		/* On a phone each view at its own height. */
		.stage {
			aspect-ratio: auto;
		}

		.layer {
			position: static;
			display: none;
		}

		[data-view='terms'] .layer[data-for-view='terms'],
		[data-view='link'] .layer[data-for-view='link'],
		[data-view='repayments'] .layer[data-for-view='repayments'],
		[data-view='assets'] .layer[data-for-view='assets'],
		[data-view='method'] .layer[data-for-view='method'] {
			display: flex;
			flex-direction: column;
		}

		.layer :global(img.page) {
			height: auto;
		}

		.method :global(img.sheet) {
			width: 100%;
			height: auto;
			border-right: 0;
			border-bottom: 1px solid var(--line);
			box-shadow: none;
		}

		.capabilities {
			padding: 1.25rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.layer {
			transition: none;
		}
	}
</style>
