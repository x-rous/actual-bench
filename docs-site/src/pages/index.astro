---
// The Actual Bench front page.
//
// This page is the product's first impression, so it is built by hand rather
// than with Starlight's splash template: it tells one story, from "what does
// my money look like" to "running in a minute", with the real app (photographed
// from the public demo household) as the evidence. The documentation itself
// lives behind it, unchanged, in Starlight.
import '@fontsource-variable/schibsted-grotesk';
import { Image, getImage } from 'astro:assets';
import WholePicture from '../components/landing/WholePicture.astro';
import BudgetShowcase from '../components/landing/BudgetShowcase.astro';
import { pictureAccounts, pictureAnswers } from '../components/landing/demo-household';

import logo from '../assets/actual-bench-icon.png';
import insightsSummary from '../assets/landing/insights-summary.png';
import cashBuffer from '../assets/landing/insights-cash-buffer.png';
import waterfall from '../assets/landing/insights-waterfall.png';
import moneyFlow from '../assets/landing/insights-money-flow.png';
import spending from '../assets/landing/insights-spending.png';
import loanTerms from '../assets/landing/loan-terms.png';
import cardOverview from '../assets/landing/card-overview.png';
import assetHome from '../assets/landing/asset-home.png';
import accounts from '../assets/landing/accounts.png';
import cashflow from '../assets/landing/cashflow.png';
import progressNetWorth from '../assets/landing/progress-net-worth.png';
import progressDebt from '../assets/landing/progress-debt-payoff.png';
import progressSavings from '../assets/landing/progress-savings-rate.png';
import progressConsistency from '../assets/landing/progress-savings-consistency.png';
import progressBuffer from '../assets/landing/progress-cash-buffer.png';
import progressAssets from '../assets/landing/progress-asset-composition.png';
import ruleDiagnostics from '../assets/landing/bench-rule-diagnostics.png';
import payeeCleanup from '../assets/landing/bench-payee-cleanup.png';
import backups from '../assets/landing/bench-backups.png';
import actualql from '../assets/landing/bench-actualql.png';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const docs = (path: string) => `${base}${path}`;
const DEMO = 'https://actual-bench-demo.vercel.app';
const GITHUB = 'https://github.com/x-rous/actual-bench';

const title = 'Actual Bench: the whole picture of your money, from your Actual Budget';
const description =
	'Actual Bench turns your Actual Budget data into a complete picture of your financial life: every loan, card, home and investment, what you own and owe, and insights you have never had about your money. Free, open source and self-hosted.';
const social = await getImage({ src: insightsSummary, width: 1200, format: 'png' });
const socialUrl = new URL(social.src, Astro.site).href;

const runCommand =
	'docker run -d --name actual-bench --restart unless-stopped \\\n  -p 3000:3000 -v actual-bench-data:/data xrous/actual-bench:latest';

// Screenshots are full of 1px table borders and small numerals, where lossy
// encoding is at its worst, so these keep the site's quality setting
// (astro.config.mjs) and offer widths up to 3x the size each is shown at.
const shot = { format: 'webp' as const };

const ownAndOwe = [
	{
		id: 'loans',
		name: 'Loans',
		title: 'Know every loan inside out.',
		body: 'Enter your mortgage, car or personal loan the way the contract reads. Bench lines up every installment with the payment you made in Actual, splits it into principal and interest for you, and shows exactly where the loan is heading.',
		points: [
			'Payoff date, interest paid and interest still to come',
			'Rate changes, extra payments, offsets and redraw',
			'See what an extra payment saves before you make it',
			'Link the loan to the home or car it paid for',
		],
		image: loanTerms,
		alt: 'A home mortgage in Actual Bench: the loan terms beside a balance-over-time chart running to its payoff in July 2044, with the 2,988 of interest and three months that two extra payments saved.',
		link: docs('user-guide/assets-debt/'),
	},
	{
		id: 'cards',
		name: 'Credit Cards',
		title: 'Never wonder what a card bill still needs.',
		body: 'Every statement is checked against your transactions, so you always know what is due, what is paid and what is left, and when. Instalment plans are tracked to the last payment.',
		points: [
			'Next payment, due date and credit used at a glance',
			'Instalment plans, limit history and annual-fee reminders',
			'A payoff plan with your debt-free month',
			'Highest-rate-first or smallest-balance-first, compared',
		],
		image: cardOverview,
		alt: 'A credit card overview: statements to review, the next payment and its due date, total owed, available credit, and the balance over six months against the limit.',
		link: docs('user-guide/credit-cards/'),
	},
	{
		id: 'assets',
		name: 'Assets',
		title: 'Your home and car, not just a number.',
		body: 'Register what you own and Bench follows it through time: its value, what you put in, the debt against it and what it earns. Your home shows its real gain, and a rental shows its real return.',
		points: [
			'Value over time against the capital you invested',
			'Equity and loan-to-value from the linked loan',
			'Rental income and running costs, year by year',
			'Depreciation schedules for cars and equipment',
		],
		image: assetHome,
		alt: 'The family home in Actual Bench: current value, capital invested, value gain and total return, with its recorded value since 2018 against the capital put in and the mortgage against it.',
		link: docs('user-guide/asset-registry/'),
	},
	{
		id: 'classes',
		name: 'Account types',
		title: 'Tell Bench once what each account is.',
		body: 'Checking, savings, fixed deposit, investment, retirement, property, vehicle, loan, credit card and more. Mark what you can spend today and what is locked away. One minute of setup, and every view understands your money.',
		points: [
			'Thirteen account classes, set per account or per group',
			'Money you can use now, kept apart from money that is locked',
			'Groups and balances side by side',
			'Never changes how Actual budgets an account',
		],
		image: accounts,
		alt: 'The Accounts table grouped into credit cards, daily banking and loans, each account with its class, whether its money is available, and its balance.',
		link: docs('user-guide/accounts/'),
	},
];

// What a first look at Financial Insights tells the demo household, pinned to
// where each figure sits in the hero screenshot (fractions of its width and height).
const notes = [
	{ x: 0.975, y: 0.13, text: 'A savings rate 7 points higher than last year.' },
	{ x: 0.885, y: 0.346, text: 'Their cash would last 9.2 months, loans and all.' },
	{ x: 0.509, y: 0.775, text: 'Every change in net worth, explained to the cent.' },
];

const progressCards = [
	{ image: progressSavings, alt: 'Savings rate card: 38.5% over the period, best month September, twelve months in a row above zero.' },
	{ image: progressBuffer, alt: 'Cash buffer card: 9.2 months of spending covered, more than twelve counting investments they can reach.' },
	{ image: progressDebt, alt: 'Debt payoff card: loans lower eleven months in a row, debt-free in about 21 years.' },
	{ image: progressConsistency, alt: 'Savings consistency card: money saved in 12 of the last 12 months.' },
	{ image: progressNetWorth, alt: 'Net worth journey card: net worth up 20.1% over the year, highest in the latest month.' },
	{ image: progressAssets, alt: 'Asset composition card: what they own, split by share between cash, investments and property.' },
];

const bench = [
	{
		title: 'Keep your books right',
		image: ruleDiagnostics,
		alt: 'Rule Diagnostics: a rule whose conditions contradict each other, and identical rules with a one-click merge.',
		items: [
			['Bank Reconciliation', 'Drop in a statement, even a PDF, and settle every difference with Actual in one reviewed step.', 'user-guide/bank-reconciliation/'],
			['Payee Cleanup', 'Merge the duplicate payees your bank keeps creating, and add the rules that stop them coming back.', 'user-guide/payee-cleanup/'],
			['Rule Diagnostics', 'Find broken, conflicting and duplicate rules, see why, and fix them on the spot.', 'user-guide/rule-diagnostics/'],
		],
	},
	{
		title: 'Shape your budget at scale',
		image: payeeCleanup,
		alt: 'Payee Cleanup suggesting two payees to merge, what changes, and a rule to stop the duplicate coming back.',
		items: [
			['Accounts, categories, payees, tags, rules and schedules', 'Edit hundreds of rows at once, paste from a spreadsheet, import and export CSV, and see what depends on something before you delete it.', 'getting-started/editing-and-saving/'],
			['Bundle Export / Import', 'Your whole budget structure in one file: start a new budget from a template, or snapshot before a big cleanup.', 'getting-started/bundle-export-import/'],
			['Quick Create and Global Search', 'Create anything or find anything, from anywhere in the app.', 'getting-started/editing-and-saving/'],
		],
	},
	{
		title: 'Runs on its own',
		image: backups,
		alt: 'Backups saying a verified backup could be restored from a few hours ago, with each stored copy and its state.',
		items: [
			['Backups', 'Scheduled copies to a folder or S3-compatible storage, each one verified by opening it, with your last good copy always kept.', 'user-guide/backups/'],
			['Automations and Bank Sync', 'Run Actual’s bank sync, backups and syncs on a timetable, with a history of every run.', 'user-guide/automations/'],
			['Cross Budget Sync and Exchange Rates', 'Keep a household or sub-budget in step with your main one, even in another currency.', 'user-guide/budget-sync/'],
		],
	},
	{
		title: 'Look under the hood',
		image: actualql,
		alt: 'The ActualQL workbench: a query in the editor and its results as a table.',
		items: [
			['ActualQL Queries', 'Ask your budget anything, with examples, explanations and queries you can reuse across budgets.', 'user-guide/actualql/'],
			['Data Browser', 'Every table in your budget, with linked records and CSV export.', 'user-guide/data-browser/'],
			['Budget File Health', 'A full check-up of your budget file, with a report you can export.', 'user-guide/budget-file-health/'],
		],
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="icon" href={`${base}favicon.png`} />
		<link rel="canonical" href={new URL(base, Astro.site).href} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={socialUrl} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="theme-color" content="#f6f7f9" />
	</head>
	<body>
		<a class="skip" href="#main">Skip to content</a>

		<header class="bar">
			<div class="wrap bar-inner">
				<a class="brand" href={base}>
					<Image src={logo} alt="" width={28} height={28} />
					<span>Actual Bench</span>
				</a>
				<nav aria-label="Main">
					<a href="#own-and-owe">Features</a>
					<a href="#install">Install</a>
					<a href={docs('getting-started/introduction/')}>Docs</a>
					<a href={GITHUB}>GitHub</a>
					<a class="btn btn-small" href={DEMO}>Try the live demo</a>
				</nav>
			</div>
		</header>

		<main id="main">
			<section class="hero">
				<div class="wrap hero-inner">
					<div class="hero-text">
						<h1>Everything you own and owe, in one picture.</h1>
						<p class="lead">
							Actual Bench turns your Actual Budget data into a complete picture of your financial life. Tell it once
							what each account is, and your loans, cards, home and investments come together, with answers about your
							money you have never had before.
						</p>
						<div class="actions">
							<a class="btn" href={DEMO}>Try the live demo</a>
							<a class="btn btn-quiet" href="#install">Install with Docker</a>
						</div>
						<p class="fine">Free and open source. Runs on your own server, right next to Actual. Nothing to re-enter.</p>
					</div>
					<WholePicture accounts={pictureAccounts} answers={pictureAnswers(docs)} />
				</div>
			</section>

			<section class="budget" id="budget" aria-labelledby="budget-title">
				<div class="wrap">
					<h2 id="budget-title">Your budget year on one screen. Every number explains itself.</h2>
					<p class="section-lead">
						The Budget Cockpit puts twelve months side by side, for Envelope and Tracking budgets alike. Select any
						figure and Bench shows you the transactions behind it, and what moved it.
					</p>
					<BudgetShowcase guide={docs('user-guide/budget-management/')} />
				</div>
			</section>

			<section class="own" id="own-and-owe" aria-labelledby="own-title">
				<div class="wrap">
					<h2 id="own-title">Every loan, card and home, understood.</h2>
					<p class="section-lead">
						Your loans, cards, home and car are already in your budget as balances. Bench learns what each one is,
						and shows you where it is going.
					</p>
				</div>

				{ownAndOwe.map((feature) => (
					<article class="feature wrap" id={feature.id}>
						<div class="feature-head">
							<p class="feature-name">{feature.name}</p>
							<h3>{feature.title}</h3>
						</div>
						<div class="feature-body">
							<p>{feature.body}</p>
							<ul>
								{feature.points.map((point) => <li>{point}</li>)}
							</ul>
							<a class="more" href={feature.link}>How {feature.name.toLowerCase()} work</a>
						</div>
						<div class="feature-shot">
							<Image src={feature.image} alt={feature.alt} widths={[1280, 2560, 3840]} sizes="(min-width: 1340px) 1280px, 94vw" {...shot} />
						</div>
					</article>
				))}
			</section>

			<section class="insights" aria-labelledby="insights-title">
				<div class="wrap">
					<h2 id="insights-title">Then it tells you what you didn’t know.</h2>
					<p class="section-lead">
						Once Bench knows what each account is, Financial Insights reads every account and transaction and answers
						the questions a budget never asks. Each answer opens the transactions behind it, so you can always see why.
					</p>

					<figure class="insights-shot">
						<div class="shot-area">
							<div class="window">
								<Image
									src={insightsSummary}
									alt="Financial Insights in Actual Bench for the demo household: net worth, money kept, savings rate, what they own and owe month by month, the cash buffer and what changed their net worth."
									widths={[1040, 2080, 3120, 5136]}
									sizes="(min-width: 1340px) 1040px, 94vw"
									{...shot}
								/>
							</div>
							<ul class="notes" role="list">
								{notes.map((note, index) => (
									<li style={`--x: ${note.x}; --y: ${note.y}; --d: ${index * 0.45}s`}>
										<span class="leader" aria-hidden="true"></span>
										<span class="note-text"><span class="mark">{note.text}</span></span>
									</li>
								))}
							</ul>
						</div>
						<figcaption>The demo household’s Financial Insights, from the same Actual budget it already keeps.</figcaption>
					</figure>

					<div class="finding">
						<div class="finding-text">
							<h3>How long would your cash last?</h3>
							<p>
								Your cash buffer in months, worked out from what you really spend and every loan you pay.
								Then ask “what if”: drop a subscription, pay off the car, and watch your runway change. Save it as
								a scenario and come back to it.
							</p>
						</div>
						<Image src={cashBuffer} alt="The cash buffer card: 9.2 months of cover, with the monthly need laid out as spending plus each loan repayment." widths={[540, 1080, 1620, 2156]} sizes="(min-width: 960px) 540px, 92vw" {...shot} />
					</div>

					<div class="finding finding-flip">
						<div class="finding-text">
							<h3>Why did your net worth change?</h3>
							<p>
								Not just that it went up, but exactly why: money kept, loan principal paid, changes in value,
								investments. Every step adds up to the change, and Bench marks it reconciled when it does.
							</p>
						</div>
						<Image src={waterfall} alt="A net worth waterfall from the start to the end of the year, marked Reconciled." widths={[640, 1280, 1920, 2584]} sizes="(min-width: 960px) 640px, 92vw" {...shot} />
					</div>

					<div class="finding">
						<div class="finding-text">
							<h3>Where did every dollar come from and go?</h3>
							<p>
								Money in and money out, side by side and adding up to the same total. Spending, loans paid off,
								money put into savings and investments, each line one click from its transactions.
							</p>
						</div>
						<Image src={moneyFlow} alt="Money in and money out lists that add up to the same total." widths={[640, 1280, 1920, 2584]} sizes="(min-width: 960px) 640px, 92vw" {...shot} />
					</div>

					<div class="finding-wide">
						<Image src={spending} alt="The Spending tab: total spent, monthly average, spending each month by category group, and a category-by-month table shaded against each row’s usual." widths={[1280, 2560, 3840]} sizes="(min-width: 1360px) 1280px, 92vw" {...shot} />
						<p>
							And it keeps going: income, spending by category and month, your budget against reality, investments,
							property, loans and cards, and a household P&amp;L, cash flow statement and balance sheet.
							<a href={docs('user-guide/financial-insights/')}>Explore Financial Insights</a>
						</p>
					</div>
				</div>
			</section>

			<section class="plan" aria-labelledby="plan-title">
				<div class="wrap">
					<h2 id="plan-title">Plan the years ahead.</h2>
				</div>
				<article class="feature wrap">
					<div class="feature-head">
						<p class="feature-name">Cashflow Planning</p>
						<h3>Your cash, years ahead.</h3>
					</div>
					<div class="feature-body">
						<p>
							Starts from your real history and forecasts every month, up to fifty years out. See how low your cash gets
							and when, track your savings goals, and keep a careful plan beside an optimistic one.
						</p>
						<a class="more" href={docs('user-guide/cashflow-planning/')}>See Cashflow Planning</a>
					</div>
					<div class="feature-shot">
						<Image src={cashflow} alt="A five-year cash plan: cash today, the lowest point in the next twelve months, a forecast chart and a month-by-month grid of income and expenses." widths={[1280, 2560, 3840]} sizes="(min-width: 1340px) 1280px, 94vw" {...shot} />
					</div>
				</article>
			</section>

			<section class="progress" aria-labelledby="progress-title">
				<div class="wrap">
					<h2 id="progress-title">Share the win. Keep the numbers private.</h2>
					<p class="section-lead">
						Progress cards turn your milestones into pictures you can post anywhere: a savings streak, a loan paid down,
						net worth at a new high. They show shapes, percentages and months, and never a single amount.
					</p>
				</div>
				<ul class="cards wrap" role="list">
					{progressCards.map((card) => (
						<li>
							<Image src={card.image} alt={card.alt} widths={[400, 800, 1200]} sizes="(min-width: 1100px) 400px, (min-width: 700px) 45vw, 88vw" {...shot} />
						</li>
					))}
				</ul>
			</section>

			<section class="bench" aria-labelledby="bench-title">
				<div class="wrap">
					<h2 id="bench-title">And a full workbench behind it.</h2>
					<p class="section-lead">
						When it is time to tidy up, catch up or dig in, the tools are already there.
					</p>
				</div>
				<div class="bench-groups wrap">
					{bench.map((group) => (
						<section class="bench-group" aria-label={group.title}>
							<h3>{group.title}</h3>
							<dl>
								{group.items.map(([name, text, path]) => (
									<div>
										<dt><a href={docs(path)}>{name}</a></dt>
										<dd>{text}</dd>
									</div>
								))}
							</dl>
							<Image src={group.image} alt={group.alt} widths={[1280, 2560, 3840]} sizes="(min-width: 1340px) 1280px, 94vw" {...shot} />
						</section>
					))}
				</div>
			</section>

			<section class="control" aria-labelledby="control-title">
				<div class="wrap control-inner">
					<h2 id="control-title">You decide what reaches your budget.</h2>
					<ul role="list">
						<li><strong>Review before Save.</strong> Edits to accounts, categories, rules and budget amounts wait for you, with undo, until you save them.</li>
						<li><strong>Preview before Apply.</strong> Reconciliation and budget sync show you every change first.</li>
						<li><strong>Read-only where it should be.</strong> Insights, Cashflow Planning, diagnostics and queries never change your budget.</li>
						<li><strong>Automation on your terms.</strong> Scheduled jobs run only when you switch them on, with a history of every run.</li>
					</ul>
				</div>
			</section>

			<section class="install" id="install" aria-labelledby="install-title">
				<div class="wrap">
					<h2 id="install-title">Running in a minute.</h2>
					<ol class="steps">
						<li>
							<h3>Start Actual Bench</h3>
							<p>One container, next to the Actual server you already run.</p>
							<div class="code">
								<pre><code>{runCommand}</code></pre>
								<button type="button" class="copy" data-copy={runCommand.replace(' \\\n  ', ' ')}>Copy</button>
							</div>
						</li>
						<li>
							<h3>Open it and set a password</h3>
							<p>
								Go to <code>http://localhost:3000</code>, or to your server's address or reverse-proxy URL if it runs
								on another machine, and choose the password that protects your Bench.
							</p>
						</li>
						<li>
							<h3>Connect your budget</h3>
							<p>
								Point it at your Actual server and pick a budget. Your accounts, transactions and budget are read straight
								from Actual, so nothing is re-entered. Then give your accounts their <a href={docs('user-guide/accounts/')}>types</a>
								and add your <a href={docs('user-guide/assets-debt/')}>loans</a>, <a href={docs('user-guide/credit-cards/')}>cards</a>
								and <a href={docs('user-guide/asset-registry/')}>assets</a> once, and every view you have just seen fills in with
								your own money.
							</p>
						</li>
					</ol>
					<p class="fine">
						Docker Compose, reverse proxies and hosted options are in the <a href={docs('getting-started/installation/')}>installation guide</a>.
					</p>
				</div>
			</section>

			<section class="closing">
				<div class="wrap">
					<h2>See it with a real household first.</h2>
					<p>The demo opens a full sample household with loans, cards, a home, a rental, investments and two years of history. No sign-up.</p>
					<div class="actions">
						<a class="btn" href={DEMO}>Try the live demo</a>
						<a class="btn btn-quiet" href={docs('getting-started/introduction/')}>Read the docs</a>
					</div>
				</div>
			</section>
		</main>

		<footer class="foot">
			<div class="wrap foot-inner">
				<p>
					Actual Bench is a free, open-source companion for <a href="https://actualbudget.org/">Actual Budget</a>. MIT licensed.
				</p>
				<nav aria-label="Footer">
					<a href={docs('getting-started/introduction/')}>Docs</a>
					<a href={`${GITHUB}/releases`}>Releases</a>
					<a href={GITHUB}>GitHub</a>
					<a href={`${GITHUB}/issues`}>Issues</a>
				</nav>
			</div>
		</footer>

		<script>
			for (const button of document.querySelectorAll<HTMLButtonElement>('button[data-copy]')) {
				button.addEventListener('click', async () => {
					try {
						await navigator.clipboard.writeText(button.dataset.copy ?? '');
						button.textContent = 'Copied';
					} catch {
						button.textContent = 'Select and copy';
					}
					setTimeout(() => (button.textContent = 'Copy'), 2000);
				});
			}
		</script>
	</body>
</html>

<style is:global>
	:root {
		--paper: #f6f7f9;
		--surface: #ffffff;
		--ink: #15181e;
		--ink-soft: #3d434e;
		--muted: #5f6673;
		--line: #dde1e8;
		--ledger: #1d52d1;
		--ledger-deep: #163f9f;
		--marker: #ffe24a;
		--gain: #1f8a5b;
		--radius-window: 14px;
		--radius-small: 8px;
