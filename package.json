{
  "name": "actual-bench",
  "version": "1.3.6",
  "description": "Web-based admin panel for Actual Budget — manage accounts, payees, categories, and rules via actual-http-api",
  "repository": {
    "type": "git",
    "url": "https://github.com/x-rous/actual-bench"
  },
  "homepage": "https://github.com/x-rous/actual-bench#readme",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS=--max-old-space-size=2048 next dev",
    "postinstall": "node scripts/copy-sqlite-wasm.mjs",
    "preview": "NODE_OPTIONS=--max-old-space-size=512 next start",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "lint": "eslint --cache --cache-strategy content",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS=--max-old-space-size=1024 jest",
    "test:coverage": "NODE_OPTIONS=--max-old-space-size=2048 jest --coverage",
    "clean": "rm -rf .next .next-build tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@actual-app/api": "26.9.0",
    "@base-ui/react": "^1.8.0",
    "@hookform/resolvers": "^5.9.1",
    "@sqlite.org/sqlite-wasm": "^3.41.2",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.13",
    "@vercel/analytics": "^2.0.1",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.2",
    "lucide-react": "^1.47.0",
    "next": "^16.2.3",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^4.10.38",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.88.0",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.3.6",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
