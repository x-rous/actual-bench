# ── Dependencies ──────────────────────────────────────────────────────────────
# No trailing slash: a trailing slash matches directories only, so a *symlink*
# named node_modules is not ignored — which is how one reached a commit.
node_modules

# ── Next.js build output ──────────────────────────────────────────────────────
.next/
.next-build/
out/

# ── Production / dist ─────────────────────────────────────────────────────────
build/
dist/

# ── Testing ───────────────────────────────────────────────────────────────────
coverage/

# ── Environment files ─────────────────────────────────────────────────────────
# .env.example is committed intentionally as a template — all others are ignored
.env
.env.*
!.env.example

# Local dev compose — carries private infra (host paths, hostnames, proxy)
docker/docker-compose.dev.yml

# ── TypeScript ────────────────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Editor ────────────────────────────────────────────────────────────────────
.vscode/

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
*.pem

# ── Deployment ────────────────────────────────────────────────────────────────
.vercel

# ── Generated SQLite WASM asset ───────────────────────────────────────────────
public/sqlite/sqlite3.wasm

# ── Local Claude Code settings (user-specific, not project config) ─────────────
.claude/settings.local.json

# ── Internal AI agent prompts (not relevant to end users) ─────────────────────
agents/

.next
.next-build
.claude/
specs/
.specify/
# Local app metadata database for dev/self-hosted mounts
.actual-bench-data/
.agents/
skills-lock.json

# Build output for the documentation screenshot instance, which runs beside a
# long-lived development server and must never be committed.
.next-shots
