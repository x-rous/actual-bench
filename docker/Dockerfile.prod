# ── Stage 1: full build ────────────────────────────────────────────────────────
FROM node:24.21.0-alpine AS builder
WORKDIR /app
# Native modules such as better-sqlite3 may fall back to node-gyp on Alpine.
# Upgraded first: see the note in the runtime stage for why the base tag alone
# is not enough.
RUN apk upgrade --no-cache && apk add --no-cache python3 make g++
COPY package*.json ./
COPY scripts/copy-sqlite-wasm.mjs ./scripts/copy-sqlite-wasm.mjs
RUN npm ci
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
# Produces a standalone server under .next-build/standalone (output: "standalone")
RUN npm run build

# ── Stage 2: lean runtime image (Next.js standalone output) ───────────────────
FROM node:24.21.0-alpine AS runner
WORKDIR /app

# Alpine's own packages, refreshed from the repositories at build time.
#
# Moving the base tag forward is not enough on its own, and assuming otherwise
# is what left eleven OpenSSL advisories in a shipped image: a Node patch bump
# changes Node, while the apk layer underneath it is whatever snapshot that
# image was built against. node:22.23.2-alpine still carried openssl 3.5.7-r0
# long after 3.5.8-r0 was published to Alpine's own repositories.
#
# The cost is that a rebuild of the same tag can pick up different package
# versions. That is the right trade for the layer holding the TLS library: a
# reproducible build of a known-vulnerable image is not worth much.
RUN apk upgrade --no-cache

# The runtime has no package manager, because it never uses one: the command is
# `node scripts/start.mjs`, which spawns the standalone `node server.js`. npm
# ships with the base image all the same, and its own dependency tree - tar,
# brace-expansion, ip-address, pacote, picomatch, sigstore - is a standing
# source of reported vulnerabilities in an image that never executes any of it.
#
# Deleted rather than upgraded. Upgrading resets the clock until npm's next
# advisory; removing it ends the category, and takes the layer with it.
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
# The standalone server is lean; 256 MB is plenty.
ENV NODE_OPTIONS=--max-old-space-size=256
# Bind all interfaces so the reverse proxy can reach the container.
ENV HOSTNAME=0.0.0.0
ENV PORT=3000
ENV ACTUAL_BENCH_DB_PATH=/data/actual-bench.sqlite

# Non-root user for security. /data stores Actual Bench app metadata.
RUN addgroup --system --gid 1001 nodejs \
 && adduser  --system --uid 1001 nextjs \
 && mkdir -p /data \
 && chown -R nextjs:nodejs /data

# Public static assets (includes public/sqlite/sqlite3.wasm for in-browser
# Budget Diagnostics).
COPY --from=builder --chown=nextjs:nodejs /app/public ./public

# Standalone server bundle: server.js + traced node_modules + package.json +
# the server-side build output (.next-build/…). This replaces copying the full
# production node_modules — only the modules the server actually imports ship.
COPY --from=builder --chown=nextjs:nodejs /app/.next-build/standalone ./

# Client static assets emitted by the build, served by the standalone server.
COPY --from=builder --chown=nextjs:nodejs /app/.next-build/static ./.next-build/static

# Branded startup wrapper (reads package.json version, spawns the standalone
# server.js). package.json comes from the standalone bundle copied above.
COPY --from=builder --chown=nextjs:nodejs /app/scripts/start.mjs ./scripts/start.mjs

USER nextjs
EXPOSE 3000

# No curl in this image on purpose (see the npm/npx removal above) — Node's
# own fetch is already here and free.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3000/api/health').then((r) => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"

CMD ["node", "scripts/start.mjs"]
