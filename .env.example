# App version is injected automatically from package.json at build time.
# No environment variables are required for a plain localhost dev setup.

# If you run the dev server behind a reverse proxy (e.g. Traefik), add your
# hostname here so Next.js allows the HMR WebSocket connection.
# Comma-separated, no protocol prefix.
# NEXT_DEV_ALLOWED_ORIGINS=your-dev-domain.example.com

# --- Optional runtime settings for a self-hosted deployment ---
# See https://x-rous.github.io/actual-bench/administration/configuration/ for the full reference.

# Path to the metadata SQLite database (defaults to /data/actual-bench.sqlite in Docker).
# ACTUAL_BENCH_DB_PATH=/data/actual-bench.sqlite

# Server log verbosity: debug | info (default) | warn | error
# LOG_LEVEL=info

# --- Credential vault (optional) ---
# Encrypts the credentials automations use. Leave it unset and Bench generates a
# key on first start and keeps it in secrets/vault.key beside the database, so
# keep that folder with the rest of your data. Set this only to hold the key
# yourself, via your secret manager. Changing it later locks stored credentials.
# See docs/UNATTENDED_SYNC.md.
# ACTUAL_BENCH_VAULT_KEY=<strong-secret>
